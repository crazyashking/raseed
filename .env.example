# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Telegram ---------------------------------------------------------------
# From @BotFather.
TELEGRAM_BOT_TOKEN=
# Comma separated numeric Telegram user IDs allowed to talk to the bot.
# Empty means nobody, which is the safe default for a single user bot.
TELEGRAM_ALLOWED_USER_IDS=

# --- Extraction provider ----------------------------------------------------
# From Google AI Studio. Never logged, never echoed back into a chat.
GEMINI_API_KEY=
# Decided 2026-08-08. See docs/DECISIONS.md for the costing.
GEMINI_MODEL=gemini-3.6-flash

# --- Storage ----------------------------------------------------------------
DATABASE_URL=sqlite:///raseed.db

# --- Money and time ---------------------------------------------------------
# ISO 4217. INR only for now, the column exists so it stays honest.
DEFAULT_CURRENCY=INR
# IANA name. Period queries bucket on merchant local time, never UTC.
DEFAULT_TIMEZONE=Asia/Kolkata
# Paise. 100 means one rupee. See brief section 18.4: Indian CGST/SGST rounding
# makes a zero tolerance fail on arithmetically correct receipts.
RECONCILIATION_TOLERANCE_MINOR=100

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
