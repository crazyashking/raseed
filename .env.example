# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Telegram ---------------------------------------------------------------
# From @BotFather.
TELEGRAM_BOT_TOKEN=
# Comma separated numeric Telegram user IDs allowed to talk to the bot.
# Empty means nobody, which is the safe default for a single user bot.
TELEGRAM_ALLOWED_USER_IDS=

# Derives each person's user_id from their Telegram account, so no external
# identifier is ever stored in the database. Invariant 3, and see
# src/raseed/identity.py for why there is no mapping table.
#
# NEVER CHANGE THIS ONCE THE LEDGER HAS DATA. Every user becomes a new user
# with an empty ledger and the old rows are unreachable, because nothing
# anywhere records who they belonged to. That is the price of not storing it.
#
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
USER_ID_SECRET=

# --- Extraction provider ----------------------------------------------------
# From Google AI Studio. Never logged, never echoed back into a chat.
# MUST be a PAID tier key. Brief section 4.2, re-verified 2026-08-08: free-tier
# content is used to improve Google's products, paid-tier content is not. These
# are real receipts, so the free tier is not an option.
GEMINI_API_KEY=
# Decided 2026-08-08. See docs/DECISIONS.md for the costing.
GEMINI_MODEL=gemini-3.6-flash
# Stage 2 (categorization) is a text task on short strings and does not need the
# model that reads a photograph. Separate setting so the expensive one can move
# without dragging this along. It must be a model with a published rate in
# raseed/extraction/pricing.py, or every Stage 2 call refuses rather than
# billing a price nobody verified.
GEMINI_CATEGORIZER_MODEL=gemini-3.5-flash-lite

# --- Storage ----------------------------------------------------------------
DATABASE_URL=sqlite:///raseed.db

# --- Money and time ---------------------------------------------------------
# ISO 4217. INR only for now, the column exists so it stays honest.
DEFAULT_CURRENCY=INR
# IANA name. Period queries bucket on merchant local time, never UTC.
DEFAULT_TIMEZONE=Asia/Kolkata
# Paise. 100 means one rupee. See brief section 18.4: Indian CGST/SGST rounding
# makes a zero tolerance fail on arithmetically correct receipts.
RECONCILIATION_TOLERANCE_MINOR=100

# --- Spend ------------------------------------------------------------------
# Brief section 16.6. A retry loop or a bad handler could burn credits
# unattended. Measured live on real receipts 2026-08-08: $0.0246 each, so $1 is
# about 40 receipts, still far above any normal day. Output tokens are 87% of
# that. Enforced in adapters/flow.py before anything is downloaded or paid for.
DAILY_COST_LIMIT_USD=1.00
# Across EVERY user, checked before the per-user cap. The per-user one does not
# bound the bill: N users each obediently under $1 a day is $N a day, and one
# account gets billed. $2.00 is about 80 receipts a day for everyone combined.
# This is a runaway guard, not a quota.
GLOBAL_DAILY_COST_LIMIT_USD=2.00

# --- Dashboard --------------------------------------------------------------
# The public HTTPS address a Cloudflare Tunnel serves, with no trailing slash.
# Leave empty and the bot hands over a loopback link instead of a button, which
# is correct while nothing is tunnelled.
#
# Telegram will not open a Mini App over plain http:// or at 127.0.0.1, so an
# http:// value here is refused at startup rather than warned about: it is not a
# weaker setup, it is a non-working one that would fail much later and much less
# clearly. The server itself stays bound to 127.0.0.1 either way, because the
# tunnel dials out from this machine and nothing needs to be reachable inbound.
#
#   cloudflared tunnel --url http://127.0.0.1:8770
#
# DASHBOARD_PUBLIC_URL=https://something.trycloudflare.com
DASHBOARD_PUBLIC_URL=

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
