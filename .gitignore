# Receipt data. Images can contain PII and this repo is public.
# Nothing under data/ is ever committed, including the redacted real receipt
# data/eval/blinkit_000.png.
data/
*.db
*.db-journal
*.db-wal
*.db-shm
# A backup taken before a migration is still a database full of real receipts.
# `*.db` does not cover `raseed.db.bak-<revision>`, and it was staged once.
*.db.*
*.bak
*.sqlite
*.sqlite3
*.jpg
*.jpeg
*.png
*.pdf

# Internal status board. Kept on disk, never published. It is a live project
# management document: budgets, people, half-made decisions and who owes what.
# Nothing in the codebase references it, unlike the brief (140 references) and
# DECISIONS.md (31), which are the public record and stay tracked.
docs/PLANNER.md

# Secrets
.env
.env.*
!.env.example

# Virtualenv
.venv/
venv/

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# OS and editor
.DS_Store
Thumbs.db
.idea/
.vscode/
